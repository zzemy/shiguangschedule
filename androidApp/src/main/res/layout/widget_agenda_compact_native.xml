<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/card_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_rounded" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="13dp">

        <!-- 顶部标签与胶囊 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_exam_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="近期考试"
                android:textColor="#E5484D"
                android:textSize="11dp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- 胶囊样式 -->
            <TextView
                android:id="@+id/tv_exam_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_agenda_pill_bg"
                android:includeFontPadding="false"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:textColor="#E5484D"
                android:textSize="10dp"
                android:textStyle="bold"
                tools:text="还有16天" />
        </LinearLayout>

        <!-- 中部：考试大标题与具体时间考场 -->
        <TextView
            android:id="@+id/tv_exam_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textSize="16dp"
            android:textStyle="bold"
            tools:text="高数期中" />

        <TextView
            android:id="@+id/tv_exam_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="10dp"
            tools:text="11.21 08:00-09:50 · 教 2-302" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 细分割线 -->
        <View
            android:id="@+id/divider_horizontal"
            android:layout_width="match_parent"
            android:layout_height="0.6dp"
            android:layout_marginVertical="6dp"
            android:background="#14000000" />

        <!-- 底部：最近待办 / 日程条目 -->
        <LinearLayout
            android:id="@+id/container_todo_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_todo_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_agenda_badge_todo"
                android:includeFontPadding="false"
                android:paddingHorizontal="4dp"
                android:paddingVertical="1dp"
                android:text="待办"
                android:textColor="#0284C7"
                android:textSize="9dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_todo_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_text_primary"
                android:textSize="11dp"
                tools:text="领笔记会员" />

            <TextView
                android:id="@+id/tv_todo_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:includeFontPadding="false"
                android:textColor="@color/widget_text_hint"
                android:textSize="9.5dp"
                tools:text="11.11" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>