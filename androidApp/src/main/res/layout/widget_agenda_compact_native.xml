<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/card_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_rounded" />

    <LinearLayout
        android:id="@+id/container_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- 顶部：分区标题 + 精致倒计时胶囊 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_exam_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:letterSpacing="0.04"
                android:text="近期考试"
                android:textColor="#C05B56"
                android:textSize="10.5dp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_exam_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_agenda_pill_bg"
                android:includeFontPadding="false"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2.5dp"
                android:textColor="#C05B56"
                android:textSize="9.5dp"
                android:textStyle="bold"
                tools:text="还有16天" />
        </LinearLayout>

        <!-- 中部：考试科目与时间考场 -->
        <TextView
            android:id="@+id/tv_exam_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textSize="16dp"
            android:textStyle="bold"
            tools:text="高等数学期中" />

        <TextView
            android:id="@+id/tv_exam_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="10.5dp"
            tools:text="11.21 08:00-09:50 · 教 2-302" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View
            android:id="@+id/divider_horizontal"
            android:layout_width="match_parent"
            android:layout_height="0.6dp"
            android:layout_marginVertical="7dp"
            android:background="#14000000" />

        <!-- 底部：最近待办 / 日程 -->
        <LinearLayout
            android:id="@+id/container_todo_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 标签底色与文案均为静态资源，渲染器仅切换显隐，避免 RemoteViews 非法 setBackgroundResource -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tv_todo_label_todo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_agenda_badge_todo"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="1.5dp"
                    android:text="@string/widget_agenda_badge_todo"
                    android:textColor="#5C6B8A"
                    android:textSize="9dp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_todo_label_schedule"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_agenda_badge_schedule"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="1.5dp"
                    android:text="@string/widget_agenda_badge_schedule"
                    android:textColor="#5F7D6B"
                    android:textSize="9dp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_todo_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_text_primary"
                android:textSize="11.5dp"
                tools:text="领笔记会员" />

            <TextView
                android:id="@+id/tv_todo_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:includeFontPadding="false"
                android:textColor="@color/widget_text_hint"
                android:textSize="9.5dp"
                tools:text="11.11" />
        </LinearLayout>
    </LinearLayout>

    <!-- 空状态：居中、克制、饱满 -->
    <LinearLayout
        android:id="@+id/container_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone"
        tools:visibility="visible">

        <View
            android:layout_width="20dp"
            android:layout_height="2dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/widget_agenda_empty_accent" />

        <TextView
            android:id="@+id/tv_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:letterSpacing="0.04"
            android:text="@string/widget_agenda_focus_empty"
            android:textColor="@color/widget_text_primary"
            android:textSize="12.5dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_empty_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:includeFontPadding="false"
            android:text="@string/widget_agenda_empty_hint"
            android:textColor="@color/widget_text_secondary"
            android:textSize="9.5dp" />
    </LinearLayout>
</FrameLayout>