<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item_root_agenda"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="50dp"
    android:orientation="horizontal"
    android:paddingHorizontal="4dp"
    android:paddingVertical="6dp">

    <!-- 左侧时间列：日期 + 时间两行 -->
    <LinearLayout
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_item_date_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textColor="@color/widget_text_hint"
            android:textSize="8.5dp"
            tools:text="11.11" />

        <TextView
            android:id="@+id/tv_item_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:includeFontPadding="false"
            android:textColor="@color/widget_text_primary"
            android:textSize="11.5dp"
            android:textStyle="bold"
            tools:text="14:30" />
    </LinearLayout>

    <View
        android:id="@+id/divider_vertical"
        android:layout_width="1dp"
        android:layout_height="30dp"
        android:layout_marginHorizontal="8dp"
        android:background="@color/widget_divider" />

    <!-- 中间内容区：徽章 + 标题 / 地点详情 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 徽章底色与文案均为静态资源，渲染器仅切换显隐，避免 RemoteViews 非法 setBackgroundResource -->
            <TextView
                android:id="@+id/tv_item_badge_todo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_agenda_badge_todo"
                android:includeFontPadding="false"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1.5dp"
                android:text="@string/widget_agenda_badge_todo"
                android:textColor="#5C6B8A"
                android:textSize="9dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_item_badge_exam"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_agenda_badge_exam"
                android:includeFontPadding="false"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1.5dp"
                android:text="@string/widget_agenda_badge_exam"
                android:textColor="#C05B56"
                android:textSize="9dp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_item_badge_schedule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_agenda_badge_schedule"
                android:includeFontPadding="false"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1.5dp"
                android:text="@string/widget_agenda_badge_schedule"
                android:textColor="#5F7D6B"
                android:textSize="9dp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_item_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_text_primary"
                android:textSize="13.5dp"
                android:textStyle="bold"
                tools:text="交微积分作业" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_item_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11dp"
            tools:text="教 2-302" />
    </LinearLayout>

    <!-- 右侧状态列：按分类切换的静态胶囊 -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp">

        <TextView
            android:id="@+id/tv_item_countdown_todo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_agenda_badge_todo"
            android:includeFontPadding="false"
            android:paddingHorizontal="7dp"
            android:paddingVertical="3dp"
            android:textColor="#5C6B8A"
            android:textSize="9.5dp"
            android:textStyle="bold"
            tools:text="还有16天" />

        <TextView
            android:id="@+id/tv_item_countdown_exam"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_agenda_badge_exam"
            android:includeFontPadding="false"
            android:paddingHorizontal="7dp"
            android:paddingVertical="3dp"
            android:textColor="#C05B56"
            android:textSize="9.5dp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_item_countdown_schedule"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_agenda_badge_schedule"
            android:includeFontPadding="false"
            android:paddingHorizontal="7dp"
            android:paddingVertical="3dp"
            android:textColor="#5F7D6B"
            android:textSize="9.5dp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>