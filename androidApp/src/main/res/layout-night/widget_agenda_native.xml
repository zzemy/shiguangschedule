<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root_dark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 卡片背景图片（用于动态设置背景着色与透明度） -->
    <ImageView
        android:id="@+id/card_bg_image_dark"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_rounded" />

    <LinearLayout
        android:id="@+id/inner_content_card_dark"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <!-- 顶部：日期星期 + 最近考试倒计时 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tv_header_title_dark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:includeFontPadding="false"
                android:textColor="@color/widget_text_primary"
                android:textSize="15dp"
                android:textStyle="bold"
                tools:text="11月5日 周三" />

            <TextView
                android:id="@+id/tv_exam_countdown_dark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/widget_agenda_pill_bg"
                android:includeFontPadding="false"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="#E5484D"
                android:textSize="10dp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="⏳ 还有16天"
                tools:visibility="visible" />
        </RelativeLayout>

        <!-- 主体：日程列表与空状态 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/list_view_agenda_dark"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:fadingEdge="none"
                android:overScrollMode="never"
                android:scrollbars="none"
                tools:listitem="@layout/widget_item_agenda_node" />

            <LinearLayout
                android:id="@+id/container_empty_dark"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="gone">

                <TextView
                    android:id="@+id/tv_empty_icon_dark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="🗓️"
                    android:textSize="24dp" />

                <TextView
                    android:id="@+id/tv_empty_title_dark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"
                    android:text="@string/widget_agenda_empty_title"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="14dp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_empty_hint_dark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"
                    android:text="@string/widget_agenda_empty_hint"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="10dp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>