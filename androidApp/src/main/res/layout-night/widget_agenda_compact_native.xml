<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/card_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_rounded" />

    <LinearLayout
        android:id="@+id/container_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/container_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/widget_agenda_item_card_bg_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tv_row_1_badge_todo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/widget_agenda_badge_todo_dark"
                            android:includeFontPadding="false"
                            android:paddingLeft="4dp"
                            android:paddingRight="4dp"
                            android:paddingTop="1dp"
                            android:paddingBottom="1dp"
                            android:text="@string/widget_agenda_compact_badge_todo"
                            android:textColor="#C2C7D0"
                            android:textSize="8dp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_row_1_badge_exam"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/widget_agenda_badge_exam_dark"
                            android:includeFontPadding="false"
                            android:paddingLeft="4dp"
                            android:paddingRight="4dp"
                            android:paddingTop="1dp"
                            android:paddingBottom="1dp"
                            android:text="@string/widget_agenda_compact_badge_exam"
                            android:textColor="#FF8A7A"
                            android:textSize="8dp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tv_row_1_badge_schedule"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/widget_agenda_compact_badge_schedule_dark"
                            android:includeFontPadding="false"
                            android:paddingLeft="4dp"
                            android:paddingRight="4dp"
                            android:paddingTop="1dp"
                            android:paddingBottom="1dp"
                            android:text="@string/widget_agenda_compact_badge_schedule"
                            android:textColor="#8FB4FF"
                            android:textSize="8dp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tv_row_1_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="13dp"
                        android:textStyle="bold"
                        tools:text="高等数学期中" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_row_1_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="9.5dp"
                    tools:text="11.21 08:00 · 教3-206" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_row_1_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="#E8E8EA"
                android:textSize="13.5dp"
                android:textStyle="bold"
                tools:text="15天" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/container_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/widget_agenda_item_card_bg_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tv_row_2_badge_todo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/widget_agenda_badge_todo_dark"
                            android:includeFontPadding="false"
                            android:paddingLeft="4dp"
                            android:paddingRight="4dp"
                            android:paddingTop="1dp"
                            android:paddingBottom="1dp"
                            android:text="@string/widget_agenda_compact_badge_todo"
                            android:textColor="#C2C7D0"
                            android:textSize="8dp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_row_2_badge_exam"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/widget_agenda_badge_exam_dark"
                            android:includeFontPadding="false"
                            android:paddingLeft="4dp"
                            android:paddingRight="4dp"
                            android:paddingTop="1dp"
                            android:paddingBottom="1dp"
                            android:text="@string/widget_agenda_compact_badge_exam"
                            android:textColor="#FF8A7A"
                            android:textSize="8dp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tv_row_2_badge_schedule"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/widget_agenda_compact_badge_schedule_dark"
                            android:includeFontPadding="false"
                            android:paddingLeft="4dp"
                            android:paddingRight="4dp"
                            android:paddingTop="1dp"
                            android:paddingBottom="1dp"
                            android:text="@string/widget_agenda_compact_badge_schedule"
                            android:textColor="#8FB4FF"
                            android:textSize="8dp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tv_row_2_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="13dp"
                        android:textStyle="bold"
                        tools:text="交微积分作业" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_row_2_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="9.5dp"
                    tools:text="11.22 14:00 · 教2-302" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_row_2_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="#E8E8EA"
                android:textSize="13.5dp"
                android:textStyle="bold"
                tools:text="明天" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/container_row_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/widget_agenda_item_card_bg_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tv_row_3_badge_todo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/widget_agenda_badge_todo_dark"
                            android:includeFontPadding="false"
                            android:paddingLeft="4dp"
                            android:paddingRight="4dp"
                            android:paddingTop="1dp"
                            android:paddingBottom="1dp"
                            android:text="@string/widget_agenda_compact_badge_todo"
                            android:textColor="#C2C7D0"
                            android:textSize="8dp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_row_3_badge_exam"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/widget_agenda_badge_exam_dark"
                            android:includeFontPadding="false"
                            android:paddingLeft="4dp"
                            android:paddingRight="4dp"
                            android:paddingTop="1dp"
                            android:paddingBottom="1dp"
                            android:text="@string/widget_agenda_compact_badge_exam"
                            android:textColor="#FF8A7A"
                            android:textSize="8dp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tv_row_3_badge_schedule"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/widget_agenda_compact_badge_schedule_dark"
                            android:includeFontPadding="false"
                            android:paddingLeft="4dp"
                            android:paddingRight="4dp"
                            android:paddingTop="1dp"
                            android:paddingBottom="1dp"
                            android:text="@string/widget_agenda_compact_badge_schedule"
                            android:textColor="#8FB4FF"
                            android:textSize="8dp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tv_row_3_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="13dp"
                        android:textStyle="bold"
                        tools:text="大学物理补课" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_row_3_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="9.5dp"
                    tools:text="11.25 10:00 · 教1-101" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_row_3_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="#E8E8EA"
                android:textSize="13.5dp"
                android:textStyle="bold"
                tools:text="5天" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/container_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:visibility="gone"
        tools:visibility="visible">

        <FrameLayout
            android:layout_width="20dp"
            android:layout_height="2dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/widget_agenda_empty_accent" />

        <TextView
            android:id="@+id/tv_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="@string/widget_agenda_compact_empty"
            android:textColor="@color/widget_text_primary"
            android:textSize="12dp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>